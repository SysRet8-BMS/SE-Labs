        <mxCell id="query" value="&lt;&lt;component&gt;&gt;&#10;:Query Service" style="shape=component;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="840" width="440" height="180" as="geometry" />
        </mxCell>

        <mxCell id="replication" value="&lt;&lt;component&gt;&gt;&#10;:Replication &amp; Durability Service" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="840" width="440" height="180" as="geometry" />
        </mxCell>

        <!-- ================= INTERFACE 1: Ingestion -> HashChain : HashRequest ================= -->
        <mxCell id="port1a" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="592" y="252" width="20" height="20" as="geometry" />
