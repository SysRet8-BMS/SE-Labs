        <!-- Legend -->
        <mxCell id="legend" value="Square = port   |   Circle = provided interface (ball)   |   Dashed line into a port = required interface (socket)" style="text;html=1;fontSize=13;fontStyle=2;align=left;" vertex="1" parent="1">
